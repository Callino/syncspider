<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="journal_gateway_tag_view_tree" model="ir.ui.view">
            <field name="name">journal_gateway_tag_view_tree</field>
            <field name="model">journal.gateway.tag</field>
            <field name="arch" type="xml">
                <tree string="journal_gateway_tag_tree" editable="bottom">
                    <field name="name"/>
                    <field name="gateway"/>
                </tree>
            </field>
        </record>

        <record id="journal_gateway_tag_action" model="ir.actions.act_window">
            <field name="name">Gateway Tags</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">journal.gateway.tag</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="journal_gateway_tag_menu" name="Gateway Tags" parent="account.account_management_menu" action="journal_gateway_tag_action" sequence="99"/>

    </data>
</odoo>